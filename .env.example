# ═══════════════════════════════════════════════════════════════
# AI_Arhitector — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in values. NEVER commit .env!

# ── API Keys (REQUIRED) ─────────────────────────────────────
# S1: API is UNSECURED without this!
ARCH_API_KEYS=key1,key2,key3

# ── OpenRouter ───────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-xxxx
# L3: Fallback keys (comma-separated, used if primary fails)
OPENROUTER_FALLBACK_KEYS=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, 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, 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, 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

# ── Google Gemini (FREE — получите на https://aistudio.google.com/apikey) ──
GOOGLE_API_KEY=AQ.Ab8RN6IvSKLyrjjFo5pOcVNJcHATs19GZa7qVDsxfZRMWRoNWQ, AQ.Ab8RN6Kny2zqxdyOkpfBxy3F5T4aTStZoKYj-2X6NTZEXVdBhA, AQ.Ab8RN6L6EACUWrL9dh0DpiZNBH071cjjIQ4PS4OCITPQkvLHPQ, AQ.Ab8RN6L6EACUWrL9dh0DpiZNBH071cjjIQ4PS4OCITPQkvLHPQ, AQ.Ab8RN6J_IZ6crtw4Cq3gVn5EAbNRbbmInx1ombI9VKW960ODWw, AQ.Ab8RN6KRfondbfKvmyLy5ZpL5JvF5TEG6G7wT4Lv1mnUcOakRg, AQ.Ab8RN6IcyXLaiSYJYlYnLqmALDeeNIkCiSCAiSBCucrpE9gPBQ, AQ.Ab8RN6KaQBVH1eQE9UY0snAQdsoCr1rWyZszo7Lo2iiJTOFUrw

# ── LLM Model ───────────────────────────────────────────────
LLM_MODEL=google/gemini-2.5-flash

# ── L4: Ollama Local Fallback ────────────────────────────────
# Uncomment to enable local model when OpenRouter is down
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b

# ── CORS (REQUIRED — no wildcard!) ──────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Blender ─────────────────────────────────────────────────
BLENDER_PATH=blender
BLENDER_TIMEOUT=300
RENDER_INTERIOR_TIMEOUT=600

# Blender instances (for load balancing across Render accounts)
BLENDER_SERVICE_URL=https://ai-arch-blender3d.onrender.com
BLENDER_SERVICE_URL_2=https://architect-blender.onrender.com
# BLENDER_SERVICE_URL_3=https://______.onrender.com  # Deploy on Account 3

# ── Output ──────────────────────────────────────────────────
OUTPUT_DIR=/app/output

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Server ──────────────────────────────────────────────────
PORT=8080
