# ═══════════════════════════════════════════════════════════════
# AI_Arhitector — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ── OpenRouter API ───────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM Model ───────────────────────────────────────────────
# Default: nvidia/nemotron-3-nano-30b-a3b:free
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# ── Blender ─────────────────────────────────────────────────
# Path to Blender binary (default: "blender")
# BLENDER_PATH=/usr/bin/blender
BLENDER_TIMEOUT=120
RENDER_INTERIOR_TIMEOUT=300

# ── Output Directory ────────────────────────────────────────
OUTPUT_DIR=/app/output

# ── Service URLs (for microservice mode) ────────────────────
# These are auto-configured in docker-compose.yml / render.yaml
# Only set these if running services manually
# LLM_SERVICE_URL=http://localhost:8081
# BLENDER_SERVICE_URL=http://localhost:8082
# GEOMETRY_SERVICE_URL=http://localhost:8083
# IFC_SERVICE_URL=http://localhost:8084
# ML_SERVICE_URL=http://localhost:8085
# DATA_SERVICE_URL=http://localhost:8086
# CAD_SERVICE_URL=http://localhost:8087
# FREECAD_SERVICE_URL=http://localhost:8088
# VECTORDB_SERVICE_URL=http://localhost:8089
# GRAPHDB_SERVICE_URL=http://localhost:8090

# ── Server ──────────────────────────────────────────────────
PORT=8080
FRONTEND_DIR=

# ── Database (optional) ────────────────────────────────────
# NEO4J_URL=http://localhost:7474
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# QDRANT_URL=http://localhost:6333
