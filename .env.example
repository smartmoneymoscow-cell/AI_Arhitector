# ═══════════════════════════════════════════════════════════════
# AI_Arhitector — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in values. NEVER commit .env!

# ── API Keys (REQUIRED) ─────────────────────────────────────
# API-ключи для доступа к сервису (клиентские ключи)
ARCH_API_KEYS=key1,key2,key3

# ═══════════════════════════════════════════════════════════════
# OPENROUTER — 4 API ключа (ТОЛЬКО БЕСПЛАТНЫЕ МОДЕЛИ)
# Получить: https://openrouter.ai/keys
# Все ключи используются с round-robin ротацией.
# При ошибке на одном ключе — автоматический переход на следующий.
# Circuit breaker: 3 ошибки → ключ отключается на 5 минут.
# ═══════════════════════════════════════════════════════════════

# Основной ключ
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# Дополнительные ключи (через запятую)
OPENROUTER_FALLBACK_KEYS=sk-or-v1-yyyyyyyy,sk-or-v1-zzzzzzzz,sk-or-v1-wwwwwwww

# Или поштучно (альтернативный формат, тоже работает):
# OPENROUTER_KEY_1=sk-or-v1-xxxxxxxxxxxx
# OPENROUTER_KEY_2=sk-or-v1-yyyyyyyyyyyy
# OPENROUTER_KEY_3=sk-or-v1-zzzzzzzzzzzz
# OPENROUTER_KEY_4=sk-or-v1-wwwwwwwwwwww

# Базовый URL OpenRouter (не менять)
OPENROUTER_BASE=https://openrouter.ai/api/v1

# ═══════════════════════════════════════════════════════════════
# GOOGLE GEMINI — 8 API ключей (БЕСПЛАТНЫЙ доступ)
# Получить: https://aistudio.google.com/apikey
# Используется как fallback когда ВСЕ OpenRouter модели недоступны.
# Round-robin ротация + circuit breaker.
# ═══════════════════════════════════════════════════════════════

# Основной ключ Gemini
GOOGLE_API_KEY=AIzaSy-xxxxxxxxxxxxxxx

# Дополнительные ключи (через запятую)
GOOGLE_API_KEYS=AIzaSy-aaaaaa,AIzaSy-bbbbbb,AIzaSy-cccccc,AIzaSy-dddddd,AIzaSy-eeeeee,AIzaSy-ffffff,AIzaSy-gggggg

# Или поштучно (альтернативный формат):
# GEMINI_KEY_1=AIzaSy-aaaaaaaaaaaaaa
# GEMINI_KEY_2=AIzaSy-bbbbbbbbbbbbbb
# GEMINI_KEY_3=AIzaSy-cccccccccccccc
# GEMINI_KEY_4=AIzaSy-dddddddddddddd
# GEMINI_KEY_5=AIzaSy-eeeeeeeeeeeeee
# GEMINI_KEY_6=AIzaSy-ffffffffffffff
# GEMINI_KEY_7=AIzaSy-gggggggggggggg
# GEMINI_KEY_8=AIzaSy-hhhhhhhhhhhhhh

# Модель Gemini (бесплатный тир)
GEMINI_MODEL=gemini-2.0-flash

# ═══════════════════════════════════════════════════════════════
# MODEL MANAGER — настройки автоматического обнаружения
# ═══════════════════════════════════════════════════════════════

# Интервал проверки бесплатных моделей (секунды)
# 14400 = 4 часа (как запрошено)
MODEL_DISCOVERY_INTERVAL=14400

# Максимум моделей в каскаде (чтобы не таймаутить)
MODEL_MAX_CASCADE=12

# Таймаут на одну модель (секунды)
MODEL_TIMEOUT=30

# Circuit breaker: сколько ошибок до отключения ключа
CB_FAILURES=3

# Circuit breaker: время отключения (секунды)
CB_COOLDOWN=300

# Модель LLM: "auto" = ModelManager, или конкретная модель
LLM_MODEL=auto

# ═══════════════════════════════════════════════════════════════
# CORS (REQUIRED — no wildcard in production!)
# ═══════════════════════════════════════════════════════════════
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Blender ─────────────────────────────────────────────────
BLENDER_PATH=blender
BLENDER_TIMEOUT=300
RENDER_INTERIOR_TIMEOUT=600

# Blender instances (for load balancing across Render accounts)
BLENDER_SERVICE_URL=https://ai-arch-blender3d.onrender.com
BLENDER_SERVICE_URL_2=https://architect-blender.onrender.com

# ── Output ──────────────────────────────────────────────────
OUTPUT_DIR=/app/output

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Server ──────────────────────────────────────────────────
PORT=8080
