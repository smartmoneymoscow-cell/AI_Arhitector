# ═══════════════════════════════════════════════════════════════
# AI_Arhitector — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in values. NEVER commit .env!

# ── API Keys (REQUIRED) ─────────────────────────────────────
# S1: API is UNSECURED without this!
ARCH_API_KEYS=key1,key2,key3

# ── OpenRouter (8 аккаунтов × 50 запросов = 400/сутки) ──────
# Все ключи равноправны, round-robin + cooldown при 429/402.
# Каждый LLM-сервис имеет: PRIMARY (уникальный) + FALLBACK (7 остальных)
OPENROUTER_API_KEY=sk-or-v1-primary-key-here
OPENROUTER_FALLBACK_KEYS=sk-or-v1-key2,sk-or-v1-key3,sk-or-v1-key4,sk-or-v1-key5,sk-or-v1-key6,sk-or-v1-key7,sk-or-v1-key8

# ── Google Gemini (8 аккаунтов — https://aistudio.google.com/apikey)
# Все ключи равноправны, round-robin при rate limit
GOOGLE_API_KEY=AIzaSy-key1
GOOGLE_FALLBACK_KEYS=AIzaSy-key2,AIzaSy-key3,AIzaSy-key4,AIzaSy-key5,AIzaSy-key6,AIzaSy-key7,AIzaSy-key8

# ── Gemini Model (прямой вызов Google API, БЕСПЛАТНО) ────────
GEMINI_MODEL=gemini-2.0-flash-lite-001

# ── LLM Model (через OpenRouter) ────────────────────────────
LLM_MODEL=google/gemini-2.5-flash:free

# ── L4: Ollama Local Fallback ────────────────────────────────
# Uncomment to enable local model when OpenRouter is down
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b

# ── Key rotation cooldowns (сек) ──────────────────────────────
# Короткий cooldown — RPM-лимит (429 без признаков квоты)
# Длинный cooldown  — дневная квота / нет кредитов (402, quota)
# Ключ автоматически пропускается во всех запросах, пока не "остынет".
# Cooldown дублируется в Redis — переживает рестарт контейнера.
KEY_COOLDOWN_RATE_LIMIT_SEC=60
KEY_COOLDOWN_QUOTA_SEC=86400

# ── CORS (REQUIRED — no wildcard!) ──────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Agent Pool (microservice isolation for agents) ─────────
AGENT_POOL_URL=http://agent-pool:8083

# ── Blender ─────────────────────────────────────────────────
BLENDER_PATH=blender
BLENDER_TIMEOUT=300
RENDER_INTERIOR_TIMEOUT=600

# Blender instances (for load balancing across Render accounts)
BLENDER_SERVICE_URL=https://ai-arch-blender3d.onrender.com
BLENDER_SERVICE_URL_2=https://architect-blender.onrender.com
# BLENDER_SERVICE_URL_3=https://______.onrender.com  # Deploy on Account 3

# ── Output ──────────────────────────────────────────────────
OUTPUT_DIR=/app/output

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Server ──────────────────────────────────────────────────
PORT=8080
