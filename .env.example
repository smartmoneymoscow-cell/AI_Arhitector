# ═══════════════════════════════════════════════════════════════
# AI_Arhitector — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ── OpenRouter API ───────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-…xxxx

# ── OpenAI API (for Whisper voice input) ────────────────────
# OPENAI_API_KEY=sk-…xxxx

# ── LLM Model ───────────────────────────────────────────────
# Default: nvidia/nemotron-3-nano-30b-a3b:free
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# ── Blender ─────────────────────────────────────────────────
# Path to Blender binary (default: "blender")
# BLENDER_PATH=/usr/bin/blender
BLENDER_TIMEOUT=120
RENDER_INTERIOR_TIMEOUT=300

# ── Output Directory ────────────────────────────────────────
OUTPUT_DIR=/app/output

# ── Redis (for Celery task queue) ──────────────────────────
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Service URLs (for microservice mode) ────────────────────
# These are auto-configured in docker-compose.yml / render.yaml
# LLM_SERVICE_URL=http://localhost:8081
# BLENDER_SERVICE_URL=http://localhost:8082

# ── Server ──────────────────────────────────────────────────
PORT=8080
FRONTEND_DIR=

# ── Database (optional) ────────────────────────────────────
# NEO4J_URL=http://localhost:7474
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# QDRANT_URL=http://localhost:6333
