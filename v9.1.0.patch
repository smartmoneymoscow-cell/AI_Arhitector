+"""
+tests/test_context_dialog.py — Tests for multi-turn dialog context.
+"""
+
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from shared.context import (
+    ProjectContext,
